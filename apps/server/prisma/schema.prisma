generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String    @map("password_hash")
  emailVerified DateTime? @map("email_verified")
  role          Role      @default(USER)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subscriptions UserSubscription[]
  folders       Folder[]
  files         File[]

  @@index([email])
  @@map("users")
}

model SubscriptionPackage {
  id String @id @default(cuid())

  name             String     @unique
  maxFolders       Int        @map("max_folders")
  maxNestingLevel  Int        @map("max_nesting_level")
  allowedFileTypes FileType[] @map("allowed_file_types")
  maxFileSizeMb    Int        @map("max_file_size_mb")
  totalFileLimit   Int        @map("total_file_limit")
  filesPerFolder   Int        @map("files_per_folder")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userSubscriptions UserSubscription[]

  @@index([name])
  @@map("subscription_packages")
}

model UserSubscription {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  packageId String?   @map("package_id")
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  package SubscriptionPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, endedAt])
  @@map("user_subscriptions")
}

model Folder {
  id       String  @id
  name     String
  userId   String  @map("user_id")
  parentId String? @map("parent_id")
  depth    Int     @default(0)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Folder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children Folder[] @relation("FolderChildren")
  files    File[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, parentId])
  @@map("folders")
}

model File {
  id         String   @id @default(cuid())
  name       String
  userId     String   @map("user_id")
  folderId   String?  @map("folder_id")
  fileType   FileType @map("file_type")
  mimeType   String   @map("mime_type")
  sizeMb     Float    @map("size_mb")
  storageKey String   @map("storage_key")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder Folder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([folderId])
  @@map("files")
}

enum Role {
  ADMIN
  USER
}

enum FileType {
  IMAGE
  VIDEO
  PDF
  AUDIO
}

model Token {
  id         String    @id @default(cuid())
  identifier String // email or user ID
  token      String    @unique
  expires    DateTime
  type       TokenType

  @@unique([type, identifier, token])
  @@index([type, token])
  @@map("tokens")
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}
